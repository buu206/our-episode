# Reference only: merge into ignored backend/.env; never overwrite existing login/data settings.
# All services remain disabled until provider conditions and test scope are verified.
CLOUD_ENABLED=false
VISION_PROVIDER=deepseek
DIRECTOR_PROVIDER=deepseek
ASR_PROVIDER=minimax
TTS_PROVIDER=minimax
DEEPSEEK_ENABLED=false
DEEPSEEK_RETENTION_VERIFIED=false
DEEPSEEK_REGION_VERIFIED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
VOLC_ENABLED=false
VOLC_RETENTION_VERIFIED=false
VOLC_REGION_VERIFIED=false
VOLC_API_KEY=
VOLC_ASR_RESOURCE=volc.seedasr.sauc.duration
VOLC_TTS_RESOURCE=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts

# MiniMax ASR and accepted system voice. Production admission remains disabled.
MINIMAX_ENABLED=false
MINIMAX_RETENTION_VERIFIED=false
MINIMAX_REGION_VERIFIED=false
MINIMAX_API_KEY=
MINIMAX_ASR_MODEL=asr-1.0
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE=male-qn-daxuesheng
MINIMAX_TTS_SPEED=1.15
MINIMAX_TTS_EMOTION=happy
MINIMAX_TTS_PITCH=0
